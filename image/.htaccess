RewriteEngine On

# 工具路径简写：/image/工具名 → /image/工具名.html
RewriteRule ^color-picker-tool$ color-picker-tool.html [L]
RewriteRule ^compress-tool$ compress-tool.html [L]
RewriteRule ^crop-tool$ crop-tool.html [L]
RewriteRule ^erweima-tool$ erweima-tool.html [L]
RewriteRule ^filter-tool$ filter-tool.html [L]
RewriteRule ^format-convert-tool$ format-convert-tool.html [L]
RewriteRule ^grid-cut-tool$ grid-cut-tool.html [L]
RewriteRule ^icon-maker-tool$ icon-maker-tool.html [L]
RewriteRule ^img-base64-tool$ img-base64-tool.html [L]
RewriteRule ^img-merge-tool$ img-merge-tool.html [L]
RewriteRule ^ocr-tool$ ocr-tool.html [L]
RewriteRule ^shuiyin-tool$ shuiyin-tool.html [L]
RewriteRule ^svg-preview-tool$ svg-preview-tool.html [L]
RewriteRule ^exif-clean-tool$ exif-clean-tool.html [L]
RewriteRule ^phash-tool$ phash-tool.html [L]
RewriteRule ^exif-view-tool$ exif-view-tool.html [L]
RewriteRule ^img-to-pdf-tool$ img-to-pdf-tool.html [L]
RewriteRule ^gif-tool$ gif-tool.html [L]
RewriteRule ^draw-tool$ draw-tool.html [L]
RewriteRule ^img-ascii-tool$ img-ascii-tool.html [L]
RewriteRule ^mosaic-tool$ mosaic-tool.html [L]
RewriteRule ^color-extract-tool$ color-extract-tool.html [L]
RewriteRule ^eye-dropper-tool$ eye-dropper-tool.html [L]
RewriteRule ^barcode-tool$ barcode-tool.html [L]
RewriteRule ^img-border-tool$ img-border-tool.html [L]
RewriteRule ^img-collage-tool$ img-collage-tool.html [L]
RewriteRule ^demask-tool$ demask-tool.html [L]

# 2026-08 新增工具
