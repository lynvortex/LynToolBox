RewriteEngine On

# 工具路径简写：/text/工具名 → /text/工具名.html
RewriteRule ^16jinzhi-tool$ 16jinzhi-tool.html [L]
RewriteRule ^authcode-tool$ authcode-tool.html [L]
RewriteRule ^base64-tool$ base64-tool.html [L]
RewriteRule ^case-convert-tool$ case-convert-tool.html [L]
RewriteRule ^chinese-convert-tool$ chinese-convert-tool.html [L]
RewriteRule ^des-tool$ des-tool.html [L]
RewriteRule ^diff-tool$ diff-tool.html [L]
RewriteRule ^encode-tool$ encode-tool.html [L]
RewriteRule ^extract-tool$ extract-tool.html [L]
RewriteRule ^hash-tool$ hash-tool.html [L]
RewriteRule ^hex-rgb-tool$ hex-rgb-tool.html [L]
RewriteRule ^json-format-tool$ json-format-tool.html [L]
RewriteRule ^markdown-tool$ markdown-tool.html [L]
RewriteRule ^mosi-tool$ mosi-tool.html [L]
RewriteRule ^password-tool$ password-tool.html [L]
RewriteRule ^rc4-tool$ rc4-tool.html [L]
RewriteRule ^regex-tool$ regex-tool.html [L]
RewriteRule ^replace-tool$ replace-tool.html [L]
RewriteRule ^reverse-tool$ reverse-tool.html [L]
RewriteRule ^second-time-change-tool$ second-time-change-tool.html [L]
RewriteRule ^sort-uniq-tool$ sort-uniq-tool.html [L]
RewriteRule ^ttf-woff2-tool$ ttf-woff2-tool.html [L]
RewriteRule ^word-count-tool$ word-count-tool.html [L]
RewriteRule ^csv-json-tool$ csv-json-tool.html [L]
RewriteRule ^xml-format-tool$ xml-format-tool.html [L]
RewriteRule ^base-convert-tool$ base-convert-tool.html [L]
RewriteRule ^lorem-tool$ lorem-tool.html [L]
RewriteRule ^shuffle-tool$ shuffle-tool.html [L]
RewriteRule ^yaml-format-tool$ yaml-format-tool.html [L]
RewriteRule ^pinyin-tool$ pinyin-tool.html [L]
RewriteRule ^tts-tool$ tts-tool.html [L]
RewriteRule ^asr-tool$ asr-tool.html [L]
RewriteRule ^html-to-md-tool$ html-to-md-tool.html [L]
RewriteRule ^toml-format-tool$ toml-format-tool.html [L]
RewriteRule ^ascii-banner-tool$ ascii-banner-tool.html [L]

# 2026-08 新增工具
RewriteRule ^tab-space-tool$ tab-space-tool.html [L]
RewriteRule ^slug-tool$ slug-tool.html [L]
RewriteRule ^sponge-tool$ sponge-tool.html [L]
RewriteRule ^sm2-tool$ sm2-tool.html [L]
RewriteRule ^sm3-tool$ sm3-tool.html [L]
RewriteRule ^sm4-tool$ sm4-tool.html [L]

# 补全简写规则
RewriteRule ^gzip-tool$ gzip-tool.html [L]
RewriteRule ^zip-tool$ zip-tool.html [L]
RewriteRule ^calc-tool$ calc-tool.html [L]
RewriteRule ^latex-tool$ latex-tool.html [L]
RewriteRule ^ast-tool$ ast-tool.html [L]
RewriteRule ^protobuf-tool$ protobuf-tool.html [L]
RewriteRule ^encoding-tool$ encoding-tool.html [L]
RewriteRule ^semver-tool$ semver-tool.html [L]
