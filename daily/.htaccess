RewriteEngine On

# 工具路径简写：/daily/工具名 → /daily/工具名.html
RewriteRule ^pomodoro-tool$ pomodoro-tool.html [L]
RewriteRule ^date-calc-tool$ date-calc-tool.html [L]
RewriteRule ^unit-convert-tool$ unit-convert-tool.html [L]
RewriteRule ^password-strength-tool$ password-strength-tool.html [L]
RewriteRule ^contrast-check-tool$ contrast-check-tool.html [L]

# 2026-08 新增工具
